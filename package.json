{
  "name": "linkbox",
  "version": "0.1.0",
  "private": true,
  "description": "Linkbox single-process Express API and Vite React SPA.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node dist/src/server/index.js",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "better-sqlite3": "^12.9.0",
    "express": "^4.19.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
